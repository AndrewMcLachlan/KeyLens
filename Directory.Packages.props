<Project>
  <!-- MSBuild ignores Condition on the <Project> element, so these must be conditioned
       per-group to keep .esproj / .sqlproj out of Central Package Management. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Asm.AspNetCore.Api" Version="5.1.75" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <PackageVersion Include="Asm" Version="5.1.75" />
    <PackageVersion Include="Asm.AspNetCore" Version="5.1.75" />
    <PackageVersion Include="Asm.AspNetCore.Modules" Version="5.1.75" />
    <PackageVersion Include="Asm.AspNetCore.Postie" Version="5.1.75" />
    <PackageVersion Include="Asm.Domain" Version="5.1.75" />
    <PackageVersion Include="Asm.Domain.Infrastructure" Version="5.1.75" />
    <PackageVersion Include="Asm.Testing.Domain" Version="5.1.75" />
    <PackageVersion Include="Asm.OAuth" Version="5.1.75" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Azure.Core" Version="1.65.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.ResourceManager.KeyVault" Version="1.5.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Certificates" Version="4.10.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SpaProxy" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Graph" Version="6.10.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Postie.AspNetCore" Version="1.1.0" />
    <PackageVersion Include="Postie.Cqrs.AspNetCore" Version="1.1.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
