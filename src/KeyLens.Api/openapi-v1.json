  "components": {
    "schemas": {
      "Config": {
        "required": [
          "audience",
          "scope"
        ],
        "type": "object",
        "properties": {
          "audience": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      },
      "Connection": {
        "required": [
          "name",
          "type",
          "config"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ConnectionType"
          },
          "enabled": {
            "type": "boolean"
          },
          "config": { },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "lastScan": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastScanError": {
            "type": [
              "null",
              "string"
            ]
          },
          "hasSecret": {
            "type": "boolean"
          }
        }
      },
      "ConnectionError": {
        "required": [
          "connectionId",
          "connectionName",
          "error"
        ],
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "format": "uuid"
          },
          "connectionName": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ConnectionType": {
        "enum": [
          "Azure",
          "Aws",
          "HashiCorpVault",
          "TlsEndpoint"
        ]
      },
      "Create": {
        "required": [
          "name",
          "type",
          "config",
          "secret"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ConnectionType"
          },
          "config": { },
          "secret": {
            "type": [
              "null",
              "string"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CredentialKind": {
        "enum": [
          "Secret",
          "Certificate",
          "Password",
          "Key"
        ]
      },
      "CredentialRecord": {
        "required": [
          "provider",
          "container",
          "containerId",
          "credentialId",
          "kind",
          "name",
          "notBefore",
          "expiresOn",
          "enabled"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "containerId": {
            "type": "string"
          },
          "credentialId": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CredentialKind"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "notBefore": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "expiresOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean"
          },
          "credentialUri": {
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          },
          "metadata": { }
        }
      },
      "CredentialsResult": {
        "required": [
          "credentials",
          "errors"
        ],
        "type": "object",
        "properties": {
          "credentials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialRecord"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionError"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Connections"
    },
    {
      "name": "Credentials"
    },
    {
      "name": "GetConfigHandler"
    }
  ]
}