<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>67164ded-8f1f-4ddd-bdc1-42a6535735b2</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <SpaRoot>..\KeyLens.App</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:3011</SpaProxyServerUrl>
  </PropertyGroup>

  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>.</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi-v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asm.AspNetCore.Api" />
    <PackageReference Include="Asm.AspNetCore.Modules" />
    <PackageReference Include="Asm.AspNetCore.Postie" />
    <PackageReference Include="Postie.AspNetCore" />
    <PackageReference Include="Postie.Cqrs.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keylens.App\KeyLens.App.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\KeyLens.Azure.KeyVault\KeyLens.Azure.KeyVault.csproj" />
    <ProjectReference Include="..\KeyLens.Azure.EntraId\KeyLens.Azure.EntraId.csproj" />
    <ProjectReference Include="..\KeyLens\KeyLens.csproj" />
    <ProjectReference Include="..\KeyLens.Security\KeyLens.Security.csproj" />
    <ProjectReference Include="..\KeyLens.Modules.Connections\KeyLens.Modules.Connections.csproj" />
    <ProjectReference Include="..\KeyLens.Modules.Credentials\KeyLens.Modules.Credentials.csproj" />
    <ProjectReference Include="..\KeyLens.Infrastructure\KeyLens.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Asm.Domain" />
  </ItemGroup>

</Project>
